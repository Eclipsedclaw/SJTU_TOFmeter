### One lead thickness of a lead x energy scan: all its muon energies, then the check run with the
### spectrum itself (lead_spectrum_t.mac). Needs the aliases of a scan definition
### (lead_energy_scan_def.mac or lead_lowE_scan_def.mac) and leadT, the lead thickness in cm.
### The seeds depend on the scan and the thickness only, so a thickness gives the same events
### whether it runs alone (scripts/lead_energy_scan.sh) or inside the full loop.

/tof/det/leadThickness {leadT} cm
/update
/control/add leadScanSeed {leadScanSeed0} {leadT}
/gun/seed {leadScanSeed}

/OutputFormat 1
/EventFilter 2
/OutputDirectory {leadScanDir}
/GeneralParticleSource 2
/tof/cosmic/model expacs
/tof/cosmic/species mu+ mu-
/tof/cosmic/angular all 2 mu+ guan mu- guan
/tof/cosmic/planeCenter 0 0 42 cm
/tof/cosmic/halfX 100 cm
/tof/cosmic/halfY 100 cm
/tof/cosmic/thetaMax 75 deg

/control/foreach {leadScanPoint} leadScanE {leadScanEnergies}
/control/execute macro/lead_spectrum_t.mac

# back to the full spectrum
/tof/cosmic/monoEnergy 0 GeV
/tof/cosmic/energyMin 0 GeV
/tof/cosmic/energyMax 1000 GeV
