### Macro file for "TOFmeter.cc"
### @author Jiancheng Zeng with Claude Opus 5.5
### @date October 2026

#/run/verbose 1
#/run/particle/applyCuts
#/event/verbose 0
#/tracking/verbose 0
#/tracking/storeTrajectory 1

# set active sensitive detector
#/hits/inactivate DetectorSD

/process/em/deexcitation World true true true
/process/list

/Visualization 0
/CheckOverlap 1
/OutputFormat 0
/TrackType 2
/TrackEdep 0

/OutputDirectory output

/GeneralParticleSource 1
/gps/particle anti_proton
/gps/ene/type Mono
/gps/ene/mono 0.001 MeV
/gps/pos/type Point
/gps/pos/centre 0.0 0.0 0.0 cm
/gps/ang/type iso

/OutputFile test
/update
/run/beamOn 1000
