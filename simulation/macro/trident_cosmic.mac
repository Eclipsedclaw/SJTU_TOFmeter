### Rate of muon tridents in the TOF-meter, one job (scripts/trident_cosmic.sh and scripts/trident_scan.sh
### run several). Needs the aliases tridentSeed, tridentEvents, tridentDir, tridentFile, tridentLead (lead
### layer, cm), tridentBias (F) and tridentPlaneZ (cm), and TOFmeter started with
### --preinit macro/physics_tridents.mac.
### Cosmic muons above 0.85 GeV (no trident below) from a 2 x 2 m plane at z = tridentPlaneZ (above the
### lead top, 21 cm + lead), zenith < 75 deg; tridents made F times more often (weight 1/F); only events
### with a trident are written.

/tof/det/leadThickness {tridentLead} cm
/update
/process/em/setBiasingFactor muToMuonPairProd {tridentBias} true
/run/physicsModified

/OutputFormat 1
/EventFilter 3
/OutputDirectory {tridentDir}
/OutputFile {tridentFile}
/gun/seed {tridentSeed}
/GeneralParticleSource 2
/tof/cosmic/model expacs
/tof/cosmic/species mu+ mu-
/tof/cosmic/angular all 2 mu+ guan mu- guan
/tof/cosmic/planeCenter 0 0 {tridentPlaneZ} cm
/tof/cosmic/halfX 100 cm
/tof/cosmic/halfY 100 cm
/tof/cosmic/thetaMax 75 deg
/tof/cosmic/energyMin 0.85 GeV
/tof/cosmic/energyMax 1000 GeV
/run/beamOn {tridentEvents}
