### Geometry check of the CURRENT geometry - no particles are simulated.
###
###   ./TOFmeter macro/vis_geometry.mac                default (DetectorConstruction.cc)
###
### For another setup, run its geometry macro first, e.g. a file check.mac with
###   /control/execute macro/geom_tofmeter_example.mac
###   /control/execute macro/vis_geometry.mac
###
### Printed to the terminal:
###   - table of every placed volume: material, centre, size and z range (cm)
###   - volume tree: copy number, sensitive detector, solid, material, mass
### Written to the current directory:
###   geometry_oblique_wire.png   all edges of all volumes, axes x (red), y (green), z (blue) at the origin
###   geometry_top_xy.png         all edges, looking down: x right, y up (footprints, alignment)
###   geometry_oblique.png        solid view from a lower angle, without the Al and steel plates
###                               (lead walls drawn as outlines in the solid views)
###   geometry_front_xz.png       looking along +y, x right, z up
###   geometry_side_yz.png        looking along -x, y right, z up
###   g4_NN.wrl                   VRML file for an interactive viewer (newest NN)
### The drawing style here is for checking only and does not change the code's
### colours. Messages "Logical volume ... not found" for parts that are not built
### are harmless.

/control/verbose 0
/tof/det/print

/vis/open TSG_OFFSCREEN
/vis/viewer/set/culling global true
/vis/viewer/set/culling invisible true
/vis/tsg/offscreen/set/size 1600 1200
/vis/viewer/set/autoRefresh false
/vis/drawVolume
/vis/viewer/set/background white
/vis/viewer/set/upVector 0 0 1
/vis/viewer/set/viewpointThetaPhi 55 30 deg

# all edges of all volumes
/vis/geometry/set/forceSolid all -1 false
/vis/geometry/set/visibility WorldLogic 0 false
/vis/viewer/set/style wireframe
/vis/scene/add/axes
/vis/tsg/offscreen/set/file geometry_oblique_wire.png
/vis/viewer/rebuild
/vis/viewer/flush
/vis/scene/activateModel Axes false
/vis/viewer/set/upVector 0 1 0
/vis/viewer/set/viewpointVector 0 0 1
/vis/tsg/offscreen/set/file geometry_top_xy.png
/vis/viewer/rebuild
/vis/viewer/flush
/vis/viewer/set/upVector 0 0 1

# solid views of the detectors: plates hidden, see-through colours made opaque
# (this driver does not draw objects behind transparent ones). Attribute changes
# need /vis/viewer/rebuild before the picture is written.
/vis/viewer/set/style surface
/vis/geometry/set/forceWireframe LeadWallXLogic 0 true
/vis/geometry/set/forceWireframe LeadWallYLogic 0 true
/vis/geometry/set/visibility FrameworkAlLogic 0 false
/vis/geometry/set/visibility FrameworkFeLogic 0 false
/vis/geometry/set/colour ScintillatorLogicX 0 0.1 0.75 0.1 1
/vis/geometry/set/colour ScintillatorLogicY 0 0.1 0.5 0.1 1
/vis/geometry/set/colour SiliconLayerLogic 0 0.9 0.2 0.2 1
/vis/geometry/set/colour YSOLayerLogic 0 0.1 0.8 0.8 1
/vis/viewer/set/viewpointThetaPhi 70 30 deg
/vis/tsg/offscreen/set/file geometry_oblique.png
/vis/viewer/rebuild
/vis/viewer/flush

# edge-on views with the plates back
/vis/geometry/set/visibility FrameworkAlLogic 0 true
/vis/geometry/set/visibility FrameworkFeLogic 0 true
/vis/viewer/set/viewpointVector 0 -1 0
/vis/tsg/offscreen/set/file geometry_front_xz.png
/vis/viewer/rebuild
/vis/viewer/flush
/vis/viewer/set/viewpointVector 1 0 0
/vis/tsg/offscreen/set/file geometry_side_yz.png
/vis/viewer/flush

/vis/open VRML2FILE
/vis/drawVolume
/vis/viewer/flush

# volume tree last: /vis/drawTree turns off the culling of invisible volumes
/vis/ASCIITree/verbose 15
/vis/drawTree ! ATree
