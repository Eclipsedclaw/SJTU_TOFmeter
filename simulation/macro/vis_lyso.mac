### Pictures of the LYSO setup for slides, no particles: the geometry of macro/muonic_xray_lyso.mac with the defaults of
### condor/muonic_xray_czt_submit.sh --detector lyso (keep them in step): the Si/YSO stack out, the 4 cm Al target at
### z = 32.5 to 36.5 cm and the LYSO panel (126.88 x 126.88 x 3.18 mm, 20 x 20 pixels of 6.25 x 6.25 x 3 mm on a 6.33 mm pitch,
### ESR between and over them, a 0.1 mm Al frame, Al on top) at z = 32.182 to 32.5 cm, against the target's bottom face. scripts/geometry_lyso.sh runs it, finishes
### its pictures and draws the setup to scale (analysis/geometry_schematic.C). By hand:
###   ./TOFmeter macro/vis_lyso.mac > output/geometry_lyso/geometry.log
### Writes to output/geometry_lyso/raw/ (4000 x 3000 pixels):
###   setup.png    the whole setup cut open at y = 1.0 cm (through the middle of a row of pixels and the middle bar of the
###                top and bottom TOF), seen from the -y side
###   target.png   the target and the LYSO panel from below, the middle TOF over them
###   panel.png    a corner of the LYSO panel from below and close up: its pixels and gaps under the target
### Colours as macro/vis_czt.mac (the pixel panel purple). The ESR between the pixels and the Al frame are not drawn (its faces lie in
### those of the pixels, which a renderer cannot tell apart): the 0.67 mm gaps show what is behind them.

/control/verbose 0
/tof/det/worldSize 420 420 300 cm
/tof/det/stack false
/tof/target/size 20 20 4 cm
/tof/target/position 0 0 34.5 cm
/control/execute macro/panel_lyso.mac
/tof/czt/position 0 0 32.332 cm
/update
/tof/det/print
/control/shell mkdir -p output/geometry_lyso/raw

/vis/open TSG_OFFSCREEN
/vis/tsg/offscreen/set/size 4000 3000
/vis/viewer/set/autoRefresh false
/vis/viewer/set/culling global true
/vis/viewer/set/culling invisible true
/vis/drawVolume
/vis/viewer/set/background white
/vis/viewer/set/upVector 0 0 1
/vis/geometry/set/visibility WorldLogic 0 false
/vis/geometry/set/visibility LYSOPanelLogic 0 false
/vis/geometry/set/visibility LYSOFrameLogic 0 false
/vis/viewer/set/style wireframe
/vis/viewer/set/hiddenEdge true
/vis/viewer/set/globalLineWidthScale 2
/vis/viewer/set/lightsMove object
/vis/geometry/set/colour AbsorberLogic 0 0.353 0.373 0.400 1
/vis/geometry/set/colour LeadWallXLogic 0 0.353 0.373 0.400 1
/vis/geometry/set/colour LeadWallYLogic 0 0.353 0.373 0.400 1
/vis/geometry/set/colour FrameworkFeLogic 0 0.710 0.729 0.761 1
/vis/geometry/set/colour SupportBeamLogic 0 0.710 0.729 0.761 1
/vis/geometry/set/colour FrameworkAlLogic 0 0.659 0.800 0.910 1
/vis/geometry/set/colour ScintillatorLogicX 0 0.302 0.690 0.314 1
/vis/geometry/set/colour ScintillatorLogicY 0 0.302 0.690 0.314 1
/vis/geometry/set/colour TargetLogic 0 0.949 0.612 0.071 1
/vis/geometry/set/colour LYSOPixelLogic 0 0.478 0.251 0.631 1

# the whole setup, cut open at y = 1.0 cm (the part at larger y kept), from the -y side: x to the right
/vis/viewer/set/cutawayMode intersection
/vis/viewer/addCutawayPlane 0 1.0 0 cm 0 1 0
/vis/viewer/set/viewpointThetaPhi 75 -62 deg
/vis/viewer/set/lightsVector 0.45 -0.8 0.6
/vis/viewer/set/targetPoint 0 25 50 cm
/vis/viewer/zoomTo 1.3
/vis/tsg/offscreen/set/file output/geometry_lyso/raw/setup.png
/vis/viewer/rebuild
/vis/viewer/flush

# the target and the LYSO panel from below, with the middle TOF (bars along y) over them
/vis/viewer/clearCutawayPlanes
/vis/geometry/set/visibility AbsorberLogic 0 false
/vis/geometry/set/visibility LeadWallXLogic 0 false
/vis/geometry/set/visibility LeadWallYLogic 0 false
/vis/geometry/set/visibility FrameworkFeLogic 0 false
/vis/geometry/set/visibility SupportBeamLogic 0 false
/vis/geometry/set/visibility FrameworkAlLogic 0 false
/vis/geometry/set/visibility ScintillatorLogicX 0 false
/vis/viewer/set/viewpointThetaPhi 120 -60 deg
/vis/viewer/set/lightsVector 0.45 -0.7 -0.6
/vis/viewer/set/targetPoint 0 0 35 cm
/vis/viewer/zoomTo 1.25
/vis/tsg/offscreen/set/file output/geometry_lyso/raw/target.png
/vis/viewer/rebuild
/vis/viewer/flush

# a corner of the panel close up from below, the target over it: the pixels and the gaps between them
/vis/geometry/set/visibility ScintillatorLogicY 0 false
/vis/viewer/set/viewpointThetaPhi 125 -60 deg
/vis/viewer/set/lightsVector 0.45 -0.7 -0.6
/vis/viewer/set/targetPoint 6.5 6.5 33 cm
/vis/viewer/zoomTo 4.5
/vis/tsg/offscreen/set/file output/geometry_lyso/raw/panel.png
/vis/viewer/rebuild
/vis/viewer/flush
