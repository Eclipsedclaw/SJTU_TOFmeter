### Geometry check of the muonic X-ray target, no particles simulated:
###   ./TOFmeter macro/vis_target.mac
### Builds the setup of macro/geom_target_al.mac (change that line for another target), prints the
### placed volumes (/tof/det/print) and writes to output/geometry_target/:
###   setup_oblique.png     the whole setup with the target
###   target_oblique.png    the target and the Compton detector (Si/YSO stack), zoomed
###   target_side_yz.png    edge-on, looking along -x, zoomed on z = 15 ... 45 cm
###   target_front_xz.png   edge-on, looking along +y, the same region, with labels and the gap
### Target orange, Si red, YSO cyan, plastic bars green, Al plates light blue. In the solid views
### the Al plates, the middle-TOF bars, the lead walls and the corner beams are outlines, so they do
### not hide the target; the edge-on views are all outlines. The colours are for this check only.
### Messages "Logical volume ... not found" for parts not built are harmless.

/control/verbose 0
/control/execute macro/geom_target_al.mac
/tof/det/print
/control/shell mkdir -p output/geometry_target

/vis/open TSG_OFFSCREEN
/vis/viewer/set/culling global true
/vis/viewer/set/culling invisible true
/vis/tsg/offscreen/set/size 1600 1200
/vis/viewer/set/autoRefresh false
/vis/drawVolume
/vis/viewer/set/background white
/vis/viewer/set/upVector 0 0 1
/vis/geometry/set/visibility WorldLogic 0 false
/vis/viewer/set/style surface
# opaque colours: this driver does not draw objects behind transparent ones
/vis/geometry/set/colour TargetLogic 0 1 0.55 0 1
/vis/geometry/set/colour ScintillatorLogicX 0 0.1 0.75 0.1 1
/vis/geometry/set/colour ScintillatorLogicY 0 0.1 0.6 0.1 1
/vis/geometry/set/colour SiliconLayerLogic 0 0.9 0.2 0.2 1
/vis/geometry/set/colour YSOLayerLogic 0 0.1 0.75 0.75 1
/vis/geometry/set/colour FrameworkAlLogic 0 0.35 0.5 0.95 1
/vis/geometry/set/forceWireframe LeadWallXLogic 0 true
/vis/geometry/set/forceWireframe LeadWallYLogic 0 true
/vis/geometry/set/forceWireframe SupportBeamLogic 0 true
/vis/geometry/set/forceWireframe FrameworkAlLogic 0 true
/vis/geometry/set/forceWireframe ScintillatorLogicY 0 true

# the whole setup
/vis/viewer/set/viewpointThetaPhi 70 30 deg
/vis/tsg/offscreen/set/file output/geometry_target/setup_oblique.png
/vis/viewer/rebuild
/vis/viewer/flush

# the target region, lead and steel hidden
/vis/geometry/set/visibility AbsorberLogic 0 false
/vis/geometry/set/visibility LeadWallXLogic 0 false
/vis/geometry/set/visibility LeadWallYLogic 0 false
/vis/geometry/set/visibility FrameworkFeLogic 0 false
/vis/geometry/set/visibility SupportBeamLogic 0 false
/vis/viewer/set/targetPoint 0 0 30 cm
/vis/viewer/zoomTo 2.8
/vis/viewer/set/viewpointThetaPhi 65 35 deg
/vis/tsg/offscreen/set/file output/geometry_target/target_oblique.png
/vis/viewer/rebuild
/vis/viewer/flush

# edge-on views, all outlines
/vis/viewer/set/style wireframe
/vis/geometry/set/forceSolid all -1 false
/vis/viewer/set/globalLineWidthScale 2
/vis/viewer/zoomTo 3.5
/vis/viewer/set/viewpointVector 1 0 0
/vis/tsg/offscreen/set/file output/geometry_target/target_side_yz.png
/vis/viewer/rebuild
/vis/viewer/flush

# looking along +y with labels and the gap between the stack and the target
/vis/set/textColour black
/vis/set/colour black
/vis/set/lineWidth 2
/vis/scene/add/arrow -5 0 31.6 -5 0 35.5 cm
/vis/scene/add/text -4.3 0 33.3 cm 18 0 0 3.9 cm
/vis/scene/add/text 19 0 40.4 cm 16 0 0 middle-TOF bars, z 39.8 to 40.4
/vis/scene/add/text 19 0 38.3 cm 16 0 0 Al2 plate, z 37.5 to 37.8
/vis/scene/add/text 11 0 35.4 cm 16 0 0 Al target 20 x 20 x 1 cm, z 35.5 to 36.5
/vis/scene/add/text 11 0 31.2 cm 16 0 0 Si/YSO stack (Compton detector), top z 31.6
/vis/scene/add/text 19 0 18.1 cm 16 0 0 Al3 plate, z 17.5 to 17.8
# shifted 10 cm to +x so that the labels fit
/vis/viewer/set/targetPoint 10 0 30 cm
/vis/viewer/set/viewpointVector 0 -1 0
/vis/tsg/offscreen/set/file output/geometry_target/target_front_xz.png
/vis/viewer/rebuild
/vis/viewer/flush
